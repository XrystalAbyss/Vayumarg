# ==============================================================================
# VAYUMARG CONFIGURATION (.env.example)
# Copy this file to .env for local development. Never commit .env into git.
# ==============================================================================

# Database Configuration (Docker PostGIS exposed on port 5433 to avoid host conflicts)
POSTGRES_USER=vayumarg_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vayumarg
POSTGRES_TEST_DB=vayumarg_test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Canonical Database URL (PostGIS / PostgreSQL - Persistent Research / Dev)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://vayumarg_user:your_secure_password_here@127.0.0.1:5433/vayumarg

# Isolated Test Database URL (Strictly for automated integration tests)
TEST_DATABASE_URL=postgresql+psycopg://vayumarg_user:your_secure_password_here@127.0.0.1:5433/vayumarg_test

# Fallback Database URL for lightweight testing / Docker-unavailable environments
# Note: SQLite fallback does not support full PostGIS spatial indexing.
FALLBACK_DATABASE_URL=sqlite:///data/interim/vayumarg_fallback.sqlite3

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
MANIFEST_DIR=./data/manifests

# PostGIS Strict SRID Check
REQUIRE_POSTGIS=true
DISABLE_SQLALCHEMY_CEXT=1
